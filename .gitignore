# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
eval/cache/
*.chroma/
.chromadb/
systems/*/chroma/

# Synthea JAR + intermediate
tools/synthea-with-dependencies.jar
tools/jre/
data/synthea_base/*.json.gz
data/synthea_base/**/*.json
!data/synthea_base/.gitkeep

# Generated large artefacts (data/ itself is versioned up to freeze).
# LLM-generated narratives (*.txt, *.meta.json) are tracked because Groq
# regeneration is rate-limited and not byte-reproducible. The intermediate
# prompt cache is not.
narratives/llm_narratives/_cache/

# Claude Code harness-local files
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Local run logs (keep eval/cache instead, that's the reproducibility anchor)
.eval_logs/
.index_*.log
.pip_install*.log
.smoke_pytest.log

# Backup files left by jsonl filter passes (history is in git, no need to keep .bak)
results/raw/*.jsonl.bak

# Smoke / W2-handoff intermediate result files (W2 errored runs are quarantined
# under results/raw/_w2_*_errored.jsonl which IS tracked for audit trail)
results/*_w2_smoke.csv

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
results/raw/a.jsonl
results/raw/b.jsonl
results/raw/c.jsonl
*.jsonl
*.jsonl
results/raw/b.jsonl
results/raw/c.jsonl
results/raw/a.jsonl
results/raw/c.jsonl
results/raw/b.jsonl
