# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.env

# Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
eval/cache/
eval/cache_1024/
eval/cache_templated/
eval/cache_noretrieval/
eval/cache_smoke/
*.chroma/
.chromadb/
systems/*/chroma/

# Synthea JAR + intermediate
tools/synthea-with-dependencies.jar
tools/jre/
data/synthea_base/*.json.gz
data/synthea_base/**/*.json
!data/synthea_base/.gitkeep

# HL7 official FHIR Validator (downloaded on demand; pinned by tools/hl7-validator/validator_cli.sha256)
tools/hl7-validator/validator_cli.jar
tools/hl7-validator/.installed

# Generated large artefacts (data/ itself is versioned up to freeze).
# LLM-generated narratives (*.txt, *.meta.json) are tracked because Groq
# regeneration is rate-limited and not byte-reproducible. The intermediate
# prompt cache is not.
narratives/llm_narratives/_cache/

# Local run logs (keep eval/cache instead, that's the reproducibility anchor)
.eval_logs/
.index_*.log
.pip_install*.log
.smoke_pytest.log

# Backup files left by jsonl filter passes (history is in git, no need to keep .bak)
results/raw/*.jsonl.bak

# Large raw result dumps — too big for git; processed summaries in results_1024/ are tracked
results/raw_1024/
results/raw_large/
results/raw_templated/
results/raw_noretrieval/
results/raw_templated.log
results/raw_noretrieval.log

# HL7 FHIR validator raw per-bundle JSON dumps (~2.3 GB); summary CSV is tracked
results/hl7_validator_raw/

# Overleaf build artifact — regenerated from paper/ sources
fhir_rag_paper_overleaf.zip

# Smoke / W2-handoff intermediate result files (W2 errored runs are quarantined
# under results/raw/_w2_*_errored.jsonl which IS tracked for audit trail)
results/*_w2_smoke.csv
results/raw/a.jsonl
results/raw/b.jsonl
results/raw/c.jsonl

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db
